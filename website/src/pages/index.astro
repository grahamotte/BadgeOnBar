---
import config from "../../../config.json";
import { badgeColors } from "../apps";
import BarItem from "../components/BarItem.astro";
import Desktop from "../components/Desktop.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Layout from "../layouts/Layout.astro";

const repoUrl = config.apps.marketingUrl;
const install = "brew install grahamotte/tap/badge-on-bar";

const modes = [
  { name: "Badge", mode: "badge", text: "A small circle with the count over the icon, like the Dock." },
  { name: "Dot", mode: "dot", text: "Just a dot in the corner when something is waiting." },
  { name: "Count", mode: "count", text: "The full number, written out next to the icon." },
  { name: "Question block", mode: "question", text: "The icon turns into a question block. Mostly for fun." },
] as const;

const zeros = [
  { name: "Show", zero: "show", text: "Stays as it is." },
  { name: "Greyscale", zero: "greyscale", text: "Fades to grey." },
  { name: "Hide", zero: "hide", text: "Steps out of the menu bar until a badge comes back." },
] as const;

const notes = [
  {
    title: "Click to go there",
    text: "Clicking an item opens or switches to that app. Option-click or right-click for Badge On Bar's settings.",
  },
  {
    title: "Arrange them your way",
    text: "Hold Command and drag the items to reorder them. macOS remembers where you put them.",
  },
  {
    title: "Your own icons, if you like",
    text: "Each item can use the app's icon or one of a set of plain monochrome symbols that match the rest of the menu bar.",
  },
  {
    title: "Stays out of the way",
    text: "No Dock icon and no window unless you open settings. It can start at login, and it checks the Dock about once a second.",
  },
];
---

<Layout>
  <section class="mx-auto w-full max-w-5xl px-6 pt-12 sm:px-8 sm:pt-20">
    <div class="max-w-2xl">
      <h1 class="text-[2.5rem] leading-[1.08] font-semibold tracking-[-0.03em] text-balance sm:text-[3.25rem]">
        Your Dock badges, up in the menu bar.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-ink-2">
        Badge On Bar is a small Mac app that copies the little red counts from your Dock into the menu bar, one item for
        each app you choose, so you can see when Mail or your team chat wants you without looking down at the Dock.
      </p>
      <div class="mt-9 flex flex-col items-start gap-x-6 gap-y-4 sm:flex-row sm:flex-wrap sm:items-center">
        <InstallCommand command={install} class="bg-card" />
        <a href={`${repoUrl}/releases/latest`} class="text-[0.9375rem] font-medium underline">Or download the app</a>
      </div>
      <p class="mt-5 text-sm text-ink-2">
        Free and open source. Version {config.apps.version}, for macOS 26.2 or later. Signed and notarized by Apple.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-14 w-full max-w-5xl px-6 sm:mt-16 sm:px-8">
    <Desktop />
  </section>

  <section class="mx-auto grid w-full max-w-5xl gap-10 px-6 py-20 sm:px-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:py-28">
    <div>
      <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance">A few ways to show a count</h2>
      <p class="mt-4 max-w-sm leading-relaxed text-ink-2">Pick one for each app, along with a badge color.</p>
      <ul class="mt-5 flex gap-2" aria-label="Badge colors">
        {badgeColors.map((color) => <li class="size-4 rounded-[5px] shadow-[inset_0_0_0_1px_var(--color-line)]" style={`background: ${color.value}`} title={color.name} />)}
      </ul>
    </div>
    <ul class="border-t border-line">
      {
        modes.map((item) => (
          <li class="flex items-center gap-6 border-b border-line py-5">
            <span class="flex h-[1.5em] w-[4.5em] shrink-0 items-center justify-center rounded-md bg-bar text-[28px] shadow-[inset_0_0_0_1px_var(--color-line)]" aria-hidden="true">
              <BarItem app="mail" count={4} mode={item.mode} />
            </span>
            <div>
              <h3 class="font-semibold">{item.name}</h3>
              <p class="mt-1 leading-relaxed text-ink-2">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-line bg-card">
    <div class="mx-auto grid w-full max-w-5xl gap-10 px-6 py-20 sm:px-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:py-24">
      <div>
        <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance">When there's nothing new</h2>
        <p class="mt-4 max-w-sm leading-relaxed text-ink-2">Choose what an app's item does when its count drops to zero.</p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-3">
        {
          zeros.map((item) => (
            <li>
              <span class="flex h-[1.5em] items-center justify-center rounded-md bg-desk text-[28px]" aria-hidden="true">
                {item.zero === "hide" ? <span class="h-px w-[1em] bg-ink-3" /> : <BarItem app="tasks" count={0} zero={item.zero} />}
              </span>
              <h3 class="mt-4 font-semibold">{item.name}</h3>
              <p class="mt-1 leading-relaxed text-ink-2">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto grid w-full max-w-5xl items-center gap-10 px-6 py-20 sm:px-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14 md:py-28">
    <div class="max-w-md">
      <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance">One small settings window</h2>
      <p class="mt-4 leading-relaxed text-ink-2">
        Your Dock apps are listed on the left. Flip the switch next to the ones you want, then choose how each one looks.
        Everything else is in General.
      </p>
      <p class="mt-4 leading-relaxed text-ink-2">
        To read the badges, Badge On Bar asks for Accessibility access the first time it opens. It only looks at the Dock,
        and nothing leaves your Mac.
      </p>
    </div>
    <img
      src="/screenshot.webp"
      width="2004"
      height="1534"
      alt="The Badge On Bar settings window. The sidebar lists Dock apps with switches, and Messages is selected, set to the Badge display, a red badge color, and Hide at zero, above a grid of menu bar icons."
      class="h-auto w-full"
      loading="lazy"
    />
  </section>

  <section class="mx-auto w-full max-w-5xl px-6 pb-20 sm:px-8 md:pb-28">
    <ul class="grid gap-x-16 gap-y-8 border-t border-line pt-12 sm:grid-cols-2">
      {
        notes.map((note) => (
          <li>
            <h3 class="font-semibold">{note.title}</h3>
            <p class="mt-1.5 leading-relaxed text-ink-2">{note.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto w-full max-w-5xl px-6 pb-24 sm:px-8 md:pb-32">
    <div class="flex flex-col items-start gap-6 rounded-[14px] border border-line bg-card px-4 py-8 sm:px-10 sm:py-10 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-5">
        <img src="/icon.png" alt="" width="64" height="64" class="size-16 shrink-0 rounded-[15px]" loading="lazy" />
        <div>
          <h2 class="text-[1.375rem] font-semibold tracking-[-0.015em]">Give it a try</h2>
          <p class="mt-1 text-ink-2">
            Install with Homebrew, then update with <code class="font-mono text-[0.92em]">brew upgrade</code>.
          </p>
        </div>
      </div>
      <InstallCommand command={install} class="bg-page" />
    </div>
    <p class="mt-8 text-sm text-ink-2">
      Badge On Bar is a rewrite of <a href="https://github.com/xiaogdgenuine/Doll" class="underline">Doll</a>, a lovely little
      app by xiaogdgenuine.
    </p>
  </section>
</Layout>
